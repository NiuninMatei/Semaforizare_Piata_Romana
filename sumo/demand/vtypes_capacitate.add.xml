<!-- Capacitatea calibrată (docs/DOCUMENTATIE.md § 6.4): aceleași tipuri ca în vtypes.add.xml, cu timpul de reacție
     al șoferilor de vehicule motorizate tau = 0,8 s în loc de 1,0 s (valoarea implicită SUMO). Cu 1,0 s, geamănul se
     blochează la cererea reală de luni 26.10 (vârful calibrat ≈5 000 veh/h; numărătoarea de referință ≈6 200 veh/h);
     cu 0,8 s servește tot vârful și vârful ×1,2. Distanța minimă și imperfecțiunea (sigma) au efect mic (baleiajul din § 6.4). -->
<additional>
  <vType id="passenger" vClass="passenger" length="4.6" accel="2.6" decel="4.5" sigma="0.5" tau="0.8" maxSpeed="16.7" color="200,200,200" />
  <vType id="bus" vClass="bus" length="12" accel="1.2" decel="4.0" sigma="0.4" tau="0.8" maxSpeed="14" color="0,120,255" guiShape="bus" />
  <vType id="truck" vClass="truck" length="9" accel="1.3" decel="4.0" sigma="0.5" tau="0.8" maxSpeed="14" color="160,100,40" guiShape="truck" />
  <vType id="motorcycle" vClass="motorcycle" length="2.2" accel="3.5" decel="6" sigma="0.5" tau="0.8" maxSpeed="16.7" color="255,200,0" guiShape="motorcycle" />
  <vType id="bicycle" vClass="bicycle" length="1.8" accel="1.2" decel="3" sigma="0.5" maxSpeed="6" color="0,200,0" guiShape="bicycle" />
  <vType id="pieton" vClass="pedestrian" length="0.3" width="0.5" maxSpeed="1.4" speedDev="0.15" color="255,90,90" guiShape="pedestrian" />
</additional>
