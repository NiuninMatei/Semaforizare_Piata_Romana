 "definitii": {
  "inceput": "ultima pornire a colectării dinaintea tăieturii (data creării unui viziune_*.log) care nu e o repornire peste un gol din reporniri_*.csv",
  "randuri_veghe": "rândurile al căror minut a început după început și s-a încheiat până la tăietură",
  "oprire": "un gol din reporniri_*.csv (ultima dovadă de viață → prima traiectorie nouă), tăiat la fereastră; anunțat dacă paznicul a notat „oprire anunțată” între 10 min înaintea opririi și repornire",
  "pauza": "un gol de cel puțin 10 s între două cadre prelucrate, din coloana `evenimente` a vegherii, care nu atinge o oprire și nu începe într-o cădere a sursei",
  "cadere_sursa": "un gol al fluxului care a oprit veghea cu alerta „fără cadre” (veghe_alerta_*.json) cât colectarea era pornită: de la ultimul cadru dinaintea alertei până la primul semn de cadre (o pauză, o repornire sau începutul primului minut cu un rând al vegherii cu starea proaspătă; o margine de sus) sau până la tăietură, în afara opririlor și a pauzelor; doar cu cel puțin o secundă acolo",
  "minut_cu_cadre": "minut întreg din fereastră care nu stă în întregime într-o oprire, într-o pauză sau într-o cădere a sursei",
  "cadre_pe_secunda": "mediana coloanei `fps` pe rândurile din fereastră cu vârsta stării sub 2,5 s",
  "reconectari": "creșterile contorului colectării (pierderi ale fluxului și încercări eșuate de redeschidere), pe toate rulările; episod = creșteri la cel mult 2 min una de alta",
  "lanturi": "o rulare pe zi, de la prima zi cu stare.json până la ultima noapte programată înaintea tăieturii; încheiată = rezultat gata / gata_fara_simulari, toți pașii cu codul 0, încheiată înaintea tăieturii",
  "vehicule": "rândurile `intrare` din intervalele încheiate în fereastră, detectate, fără factori de corecție; pietonii doar ca total pe zi"
 },
